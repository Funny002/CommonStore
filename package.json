{
  "name": "common-store",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:types && vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui --api 8923",
    "coverage": "vitest run --coverage",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "immutable": "^5.1.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funny002/CommonStore.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Funny002/CommonStore/issues"
  },
  "homepage": "https://github.com/Funny002/CommonStore#readme"
}
