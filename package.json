{
  "name": "common-store",
  "version": "1.1.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs.js"
    },
    "./vue-devtools": {
      "import": "./dist/vue-devtools.js",
      "types": "./dist/vue-devtools.d.ts",
      "require": "./dist/vue-devtools.cjs.js"
    },
    "./redux-devtools": {
      "import": "./dist/redux-devtools.js",
      "types": "./dist/redux-devtools.d.ts",
      "require": "./dist/redux-devtools.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui --api 8923",
    "coverage": "vitest run --coverage",
    "test:run": "vitest run"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funny002/CommonStore.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Funny002/CommonStore/issues"
  },
  "homepage": "https://github.com/Funny002/CommonStore#readme",
  "dependencies": {
    "@vue/devtools-kit": "^8.1.2",
    "immer": "^11.1.8"
  }
}
